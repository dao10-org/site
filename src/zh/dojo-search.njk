---
layout: layouts/base.njk
pagination:
  data: collections.dojos_zh
  size: 1
  alias: d
permalink: "/zh/dojos/{{ d.fileSlug }}/search/"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "搜索 · {{ d.data.title }}"
  dojoSlug: "{{ d.fileSlug }}"
---
{# 每个道场二级网站里的搜索页：默认只搜本道场，可以切换到全站 #}
<h1>搜索</h1>
<input type="search" id="q" class="search-box" placeholder="输入关键词" autofocus data-dojo="{{ d.fileSlug }}">
<p class="search-scope">
  <label class="check"><input type="radio" name="scope" value="dojo" checked> 只搜{{ d.data.title }}</label>
  <label class="check"><input type="radio" name="scope" value="all"> 搜全站（共道文明所有道场和文库）</label>
</p>
<ul class="post-list" id="results"></ul>
