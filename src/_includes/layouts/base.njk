<!doctype html>
<html lang="{{ 'zh-Hans' if lang == 'zh' else 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set fullTitle = (title + " · " if title else "") + site.name[lang] -%}
  {%- set desc = description or summary or (page.rawInput | mdExcerpt if page.inputPath.endsWith(".md") else "") or site.tagline[lang] -%}
  {%- set pageUrl = site.url + page.url -%}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ desc }}">
  {# 分享卡片：X / Facebook / Telegram / LinkedIn 等读取这些标签显示标题、摘要和图片 #}
  <meta property="og:site_name" content="{{ site.name[lang] }}">
  <meta property="og:type" content="{{ 'article' if date and page.url.startsWith('/zh/library/') else 'website' }}">
  <meta property="og:title" content="{{ title or site.name[lang] }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ shareImage or '/assets/img/share.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ 'zh_CN' if lang == 'zh' else 'en_US' }}">
  <meta name="twitter:card" content="summary_large_image">
  {% if site.social.x %}<meta name="twitter:site" content="@{{ site.social.x }}">{% endif %}
  {# 允许搜索引擎收录；账号、管理、统计、投稿、搜索等功能页不收录 #}
  {% if not site.indexable or noindex or noHit or eleventyExcludeFromCollections %}<meta name="robots" content="noindex, follow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ v }}">
  {# 不加载任何第三方字体、统计或脚本：大陆可访问，也不泄露读者信息 #}
</head>
<body data-dojo="{{ dojoSlug or (dojo if dojo is string else '') }}"{% if noHit %} data-nohit{% endif %}>
  {% if site.prototype %}
  <div class="proto-banner">{{ "试运行 · 《共道宪章》仍是草案，欢迎提出意见" if lang == 'zh' else "Trial run · the Charter is still a draft — feedback welcome" }}</div>
  {% endif %}
  {%- set dojoHome = (dojoSlug | dojo(collections.dojos_zh)) if dojoSlug else null -%}
  {% if dojoHome %}
  {# 道场二级网站的页头：以道场自己为主，平台只留右上角一个回主站的按钮 #}
  <header class="site-header dojo-header">
    <div class="wrap header-inner">
      <a class="brand" href="{{ dojoHome.url }}">
        {% if dojoHome.data.logo %}<img class="brand-logo" src="{{ dojoHome.data.logo }}" alt="" width="44" height="44">
        {% else %}<span class="brand-initial" aria-hidden="true">{{ dojoHome.data.title | first }}</span>{% endif %}
        <span>
          <strong>{{ dojoHome.data.title }}</strong>
          {% if dojoHome.data.subtitle %}<small>{{ dojoHome.data.subtitle | truncate(40) }}</small>{% endif %}
        </span>
      </a>
      <div class="tools">
        <button type="button" id="s2t-toggle" class="tool-btn" title="简体 / 繁體">繁</button>
        <a class="tool-btn" id="acc-link" href="/zh/account/" hidden>登录</a>
        <a class="tool-btn home-btn" href="/zh/" title="回到共道文明平台首页"><img class="home-logo" src="/assets/img/logo.svg" alt="" width="18" height="18"> {{ site.name.zh }} ↗</a>
      </div>
    </div>
    {% include "partials/dojo-nav.njk" %}
  </header>
  {% else %}
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/{{ lang }}/">
        <img class="brand-mark" src="/assets/img/logo.svg" alt="" width="44" height="44">
        <span>
          <strong>{{ site.name[lang] }}</strong>
          <small>{{ site.tagline[lang] }}</small>
        </span>
      </a>
      <div class="tools">
        {% if lang == 'zh' %}
        <button type="button" id="s2t-toggle" class="tool-btn" title="简体 / 繁體">繁</button>
        <a class="tool-btn" href="/en/">EN</a>
        <a class="tool-btn" id="acc-link" href="/zh/account/" hidden>登录</a>
        {% else %}
        <a class="tool-btn" href="/zh/">中文</a>
        {% endif %}
      </div>
    </div>
    <nav class="wrap site-nav">
      {% for item in site.nav[lang] %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </header>
  {% endif %}

  <main class="wrap" id="content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      {% if dojoHome %}
      <p><strong>{{ dojoHome.data.title }}</strong> 是 <a href="/zh/">共道文明</a> 平台上的道场，已签署<a href="/zh/charter/">《共道宪章》</a>。道场内容由道场自己撰写和负责，不代表平台立场。 · <a href="/zh/dojos/">其他道场</a></p>
      {% endif %}
      {% if lang == 'zh' %}
      <p>平台只提供渠道，不评判观点。内容默认以 <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans">CC BY-SA 4.0</a> 授权，欢迎转载、镜像、离线分发。</p>
      <p><a href="/zh/guide/">网站说明</a> · <a href="/zh/charter/">共道宪章</a> · <a href="/zh/transparency/">AI 审核透明度</a> · <a href="/zh/finance/">经费制度</a> · <a href="/zh/ledger/">公开账目</a> · <a href="/zh/about/">关于</a> · 举报违法内容：report@dao10.org</p>
      {% else %}
      <p>The platform provides a channel; it does not judge views. Content is CC BY-SA 4.0 by default — copy, mirror and share freely.</p>
      <p><a href="/en/charter/">Charter</a> · <a href="/en/about/">About</a> · Report illegal content: report@dao10.org</p>
      {% endif %}
    </div>
  </footer>
  <script src="/assets/js/app.js?v={{ v }}" defer></script>
</body>
</html>
