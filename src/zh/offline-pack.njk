<nav><h2>目录</h2>
{% for p in collections.posts_zh %}<a href="#a{{ loop.index }}">{{ p.data.title }}</a>{% endfor %}
</nav>
{% for p in collections.posts_zh %}
{% set pd = p.data.dojo | dojo(collections.dojos_zh) %}
<article id="a{{ loop.index }}">
<h2>{{ p.data.title }}</h2>
<p class="meta">{% if pd %}{{ pd.data.title }} · {% endif %}{{ p.data.author or "匿名作者" }} · {{ p.date | ymd }} · {{ p.data.license }}</p>
{{ p.content | safe }}
</article>
{% endfor %}
</body></html>
