---
permalink: /zh/search-index.json
eleventyExcludeFromCollections: true
---
{#- s = 所属道场代号（道场二级网站里的搜索默认只搜本道场） -#}
[
{%- for p in collections.posts_zh -%}
{%- set pd = p.data.dojo | dojo(collections.dojos_zh) -%}
{"t":{{ p.data.title | dump | safe }},"u":"{{ p.url }}","s":{{ (p.data.dojo if pd else "") | dump | safe }},"d":{{ (pd.data.title if pd else "") | dump | safe }},"a":{{ (p.data.author or "匿名作者") | dump | safe }},"b":{{ ((p.content | plain) + (" " + (p.data.link | ext(p.data.linkKind)).kind + " " + (p.data.link | ext(p.data.linkKind)).platform if p.data.link else "")) | dump | safe }}},
{%- endfor -%}
{%- for sp in collections.dojopages_zh -%}
{%- set pd = sp.data.dojoSlug | dojo(collections.dojos_zh) -%}
{%- if pd and not sp.data.draft -%}
{"t":{{ sp.data.title | dump | safe }},"u":"{{ sp.url }}","s":{{ sp.data.dojoSlug | dump | safe }},"d":{{ pd.data.title | dump | safe }},"a":"","b":{{ (sp.content | plain) | dump | safe }}},
{%- endif -%}
{%- endfor -%}
{%- for r in recommends -%}
{"t":{{ r.name | dump | safe }},"u":"/zh/recommend/#r-{{ r.id }}","s":"","d":"共道推荐","a":"","b":{{ (r.platform + " " + r.account + " " + r.intro + " " + (r.tags | join(" "))) | dump | safe }}},
{%- endfor -%}
{%- for d in collections.dojos_zh -%}
{"t":{{ d.data.title | dump | safe }},"u":"{{ d.url }}","s":{{ d.fileSlug | dump | safe }},"d":"道场","a":"","b":{{ (d.data.summary + " " + (d.content | plain)) | dump | safe }}}{% if not loop.last %},{% endif %}
{%- endfor -%}
]
